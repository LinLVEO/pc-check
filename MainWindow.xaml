<Window x:Class="PcCheck.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="小白电脑体检 v1.0" Height="680" Width="920" MinHeight="540" MinWidth="780"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8">
    <Window.Resources>
        <!-- 标准按钮（白底灰边，与实用官网页的默认按钮风格一致） -->
        <Style x:Key="BtnAccent" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#B8BEC6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F2F5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="22"/>
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16,10,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="2,0,0,10">
            <TextBlock Text="小白电脑体检" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
            <TextBlock Text="开源 · 干净 · 无广告" FontSize="11" Foreground="#8A919E" VerticalAlignment="Center" Margin="10,2,0,0"/>
        </StackPanel>

        <TabControl Grid.Row="1" FontSize="13">
            <!-- 基础体检 -->
            <TabItem Header="基础体检">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,2,0,10">
                        <Button x:Name="btnRefresh" Content="重新体检" Style="{StaticResource BtnAccent}" Click="Refresh_Click"/>
                        <Button Content="复制报告" Style="{StaticResource BtnAccent}" Click="Copy_Click"/>
                        <Button Content="保存报告" Style="{StaticResource BtnAccent}" Click="Save_Click"/>
                        <TextBlock x:Name="statusText" Text="就绪" Foreground="#8A919E" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="White" BorderBrush="#E3E5E8" BorderThickness="1">
                        <TextBlock x:Name="reportText" Style="{StaticResource ScrollText}" Padding="14,10" Text="正在体检，请稍候…"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 实时监控 -->
            <TabItem Header="实时监控">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,2,0,10">
                        <Button Content="开启悬浮窗" Style="{StaticResource BtnAccent}" Click="Overlay_Click"/>
                        <TextBlock Text="（完整版：右键菜单/校准/截图热键/显示项，全内置）" Foreground="#8A919E" FontSize="12" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="White" BorderBrush="#E3E5E8" BorderThickness="1">
                        <StackPanel Margin="18,14">
                            <TextBlock x:Name="monStatus" Text="实时监控中…" Foreground="#2F80ED" FontSize="12.5" Margin="0,0,0,10"/>
                            <Grid x:Name="monGrid">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <TextBlock Text="帧率（FPS）检测基于 RTSS（RivaTuner Statistics Server，MSI Afterburner 组件）；RTSS 运行时自动显示游戏帧率。" Foreground="#8A919E" FontSize="11.5" Margin="0,14,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 深度参数 -->
            <TabItem Header="深度参数">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,2,0,10">
                        <Button Content="刷新深度参数" Style="{StaticResource BtnAccent}" Click="Deep_Click"/>
                        <TextBlock x:Name="deepStatus" Text="" Foreground="#8A919E" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="White" BorderBrush="#E3E5E8" BorderThickness="1">
                        <TextBlock x:Name="deepText" Style="{StaticResource ScrollText}" Padding="14,10"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 体检日志 -->
            <TabItem Header="体检日志">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,2,0,10">
                        <Button Content="刷新日志" Style="{StaticResource BtnAccent}" Click="LogRefresh_Click"/>
                        <Button Content="打开日志文件" Style="{StaticResource BtnAccent}" Click="LogOpen_Click"/>
                        <Button Content="清除日志（自动备份）" Style="{StaticResource BtnAccent}" Click="LogClear_Click"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="White" BorderBrush="#E3E5E8" BorderThickness="1">
                        <TextBlock x:Name="logText" Style="{StaticResource ScrollText}" Padding="14,10"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- 实用官网 -->
            <TabItem Header="实用官网">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="White" BorderBrush="#E3E5E8" BorderThickness="1" Margin="6">
                    <StackPanel x:Name="sitesPanel" Margin="16,14,16,20"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
